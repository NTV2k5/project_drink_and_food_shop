# ─────────────────────────────────────────────────────────────────────────────
# Git Attributes — Normalize line endings across all platforms
# ─────────────────────────────────────────────────────────────────────────────

# Auto-detect text files and normalize to LF on checkout
* text=auto eol=lf

# Explicitly declare text files (ensure LF)
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.env       text eol=lf
*.example   text eol=lf
*.mjs       text eol=lf
*.sh        text eol=lf

# Declare binary files (do not auto-detect)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.zip       binary
*.tar.gz    binary
