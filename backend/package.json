{
  "name": "backend",
  "version": "1.0.0",
  "description": "RESTful API for Food and Drink Management System using ExpressJS and MongoDB",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "nodemon src/main.js",
    "seed": "node src/utils/seeder.js",
    "test": "cross-env NODE_ENV=test jest --config jest.config.json",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPatterns=layer1-unit",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPatterns=layer2-integration",
    "test:business": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPatterns=layer3-business",
    "test:e2e": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPatterns=layer4-e2e",
    "test:performance": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPatterns=layer5-performance",
    "test:security": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPatterns=layer6-security",
    "test:reliability": "cross-env NODE_ENV=test jest --config jest.config.json --testPathPatterns=layer7-reliability",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.json --coverage",
    "test:watch": "cross-env NODE_ENV=test jest --config jest.config.json --watch"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.2",
    "supertest": "^7.3.1"
  },
  "private": true,
  "license": "MIT"
}
