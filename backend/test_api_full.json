    {
      "name": "5. Orders & Checkout - Đơn hàng, Voucher & Shipper (16 APIs)",
      "item": [
        {
          "name": "5.1 Webhook SePay VietQR (Tự động nhận tiền)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 123456,\n  \"gateway\": \"MBBank\",\n  \"transactionDate\": \"2026-08-12 14:00:00\",\n  \"accountNumber\": \"0123456789\",\n  \"subAccount\": null,\n  \"code\": null,\n  \"content\": \"FB1001\",\n  \"transferType\": \"in\",\n  \"transferAmount\": 105000,\n  \"accumulated\": 105000,\n  \"referenceCode\": \"FT2612345678\"\n}"
            },
            "url": { "raw": "{{api_url}}/orders/sepay-webhook", "host": ["{{api_url}}"], "path": ["orders", "sepay-webhook"] },
            "description": "Webhook được hệ thống SePay tự động gọi khi ngân hàng báo chuyển khoản thành công."
          }
        },
        {
          "name": "5.2 Tạo đơn hàng mới (Checkout)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"SEPAY\",\n  \"shippingFee\": 15000,\n  \"deliveryAddress\": {\n    \"label\": \"Nhà riêng\",\n    \"fullAddress\": \"123 Nguyễn Thị Minh Khai, Q.1, TP.HCM\",\n    \"lat\": 10.7769,\n    \"lng\": 106.7009\n  },\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID_HERE\",\n      \"quantity\": 2,\n      \"selectedOptions\": [],\n      \"note\": \"Ít đá\"\n    }\n  ],\n  \"couponCode\": \"GIAM20\",\n  \"note\": \"Giao trước 12h\"\n}"
            },
            "url": { "raw": "{{api_url}}/orders", "host": ["{{api_url}}"], "path": ["orders"] },
            "description": "Tạo đơn hàng mới với hình thức VietQR SePay hoặc COD."
          }
        },
        {
          "name": "5.3 Khách xem danh sách đơn hàng của mình",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders", "host": ["{{api_url}}"], "path": ["orders"] },
            "description": "Lấy danh sách các đơn hàng cá nhân đã đặt."
          }
        },
        {
          "name": "5.4 Khách xem chi tiết 1 đơn hàng cụ thể",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders/ORDER_ID_HERE", "host": ["{{api_url}}"], "path": ["orders", "ORDER_ID_HERE"] },
            "description": "Xem chi tiết tiến trình đơn hàng theo ID."
          }
        },
        {
          "name": "5.5 Khách kiểm tra Mã giảm giá (Check Coupon)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders/coupon/GIAM20", "host": ["{{api_url}}"], "path": ["orders", "coupon", "GIAM20"] },
            "description": "Khách nhập kiểm tra hiệu lực của mã giảm giá khi Checkout."
          }
        },
        {
          "name": "5.6 Khách viết Đánh giá đơn hàng thành công",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"PRODUCT_ID_HERE\",\n  \"rating\": 5,\n  \"comment\": \"Trà sữa rất ngon, giao siêu nhanh!\"\n}"
            },
            "url": { "raw": "{{api_url}}/orders/ORDER_ID_HERE/reviews", "host": ["{{api_url}}"], "path": ["orders", "ORDER_ID_HERE", "reviews"] },
            "description": "Đánh giá sao và nhận xét đơn hàng đã nhận."
          }
        },
        {
          "name": "5.7 [Shipper] Lấy danh sách đơn chờ nhận giao",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{shipper_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders/shipper/available", "host": ["{{api_url}}"], "path": ["orders", "shipper", "available"] },
            "description": "Shipper xem danh sách các đơn hàng đã sẵn sàng giao."
          }
        },
        {
          "name": "5.8 [Shipper] Lấy danh sách đơn shipper đang nhận",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{shipper_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders/shipper/active", "host": ["{{api_url}}"], "path": ["orders", "shipper", "active"] },
            "description": "Shipper xem đơn hàng mình đang trực tiếp đi giao."
          }
        },
        {
          "name": "5.9 [Shipper] Bấm Nhận giao đơn hàng (Claim)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{shipper_token}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{api_url}}/orders/ORDER_ID_HERE/claim", "host": ["{{api_url}}"], "path": ["orders", "ORDER_ID_HERE", "claim"] },
            "description": "Shipper bấm nhận trách nhiệm giao đơn hàng."
          }
        },
        {
          "name": "5.10 Cập nhật Trạng thái đơn hàng",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{shipper_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\",\n  \"note\": \"Đã giao tận tay khách\"\n}"
            },
            "url": { "raw": "{{api_url}}/orders/ORDER_ID_HERE/status", "host": ["{{api_url}}"], "path": ["orders", "ORDER_ID_HERE", "status"] },
            "description": "Shipper/Admin cập nhật trạng thái đơn (CONFIRMED, PREPARING, DELIVERING, DELIVERED, CANCELLED)."
          }
        },
        {
          "name": "5.11 [Admin] Quản lý xem toàn bộ Đơn hàng",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders/admin", "host": ["{{api_url}}"], "path": ["orders", "admin"] },
            "description": "Admin xem danh sách tất cả các đơn hàng toàn hệ thống."
          }
        },
        {
          "name": "5.12 [Admin] Thống kê Doanh thu & Tổng đơn",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders/admin/analytics/revenue", "host": ["{{api_url}}"], "path": ["orders", "admin", "analytics", "revenue"] },
            "description": "Admin xem báo cáo biểu đồ doanh thu và chỉ số đơn hàng."
          }
        },
        {
          "name": "5.13 [Admin] Lấy danh sách Voucher",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders/coupons/admin", "host": ["{{api_url}}"], "path": ["orders", "coupons", "admin"] },
            "description": "Admin xem danh sách tất cả các mã giảm giá."
          }
        },
        {
          "name": "5.14 [Admin] Tạo Voucher giảm giá mới",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"HE2026\",\n  \"type\": \"PERCENT\",\n  \"value\": 20,\n  \"minOrderAmount\": 50000,\n  \"maxDiscountAmount\": 30000\n}"
            },
            "url": { "raw": "{{api_url}}/orders/coupons/admin", "host": ["{{api_url}}"], "path": ["orders", "coupons", "admin"] },
            "description": "Admin phát hành mã giảm giá mới."
          }
        },
        {
          "name": "5.15 [Admin] Xóa Voucher giảm giá",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{api_url}}/orders/coupons/admin/COUPON_ID_HERE", "host": ["{{api_url}}"], "path": ["orders", "coupons", "admin", "COUPON_ID_HERE"] },
            "description": "Admin xóa mã giảm giá."
          }
        },
        {
          "name": "5.16 [Admin] Xem tất cả Nhận xét Đánh giá",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/orders/reviews/admin", "host": ["{{api_url}}"], "path": ["orders", "reviews", "admin"] },
            "description": "Admin xem tất cả đánh giá từ người dùng."
          }
        }
      ]
    },
    {
      "name": "6. Locations & Geocoding - Địa điểm & Định vị OSM (5 APIs)",
      "item": [
        {
          "name": "6.1 Xem danh sách địa điểm cửa hàng",
          "request": {
            "method": "GET",
            "url": { "raw": "{{api_url}}/locations", "host": ["{{api_url}}"], "path": ["locations"] },
            "description": "Lấy danh sách các cửa hàng/chi nhánh."
          }
        },
        {
          "name": "6.2 Xem chi tiết địa điểm theo ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{api_url}}/locations/LOCATION_ID_HERE", "host": ["{{api_url}}"], "path": ["locations", "LOCATION_ID_HERE"] },
            "description": "Xem chi tiết 1 chi nhánh."
          }
        },
        {
          "name": "6.3 [Admin] Thêm địa điểm mới (Tự động Định vị OSM)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"F&B Shop - Chi nhánh RMIT\",\n  \"address\": \"700 Nguyễn Văn Linh, Tân Phong, Quận 7, Hồ Chí Minh\",\n  \"description\": \"Chi nhánh đối diện Đại học RMIT Nam Sài Gòn.\",\n  \"phone\": \"02899887766\"\n}"
            },
            "url": { "raw": "{{api_url}}/locations", "host": ["{{api_url}}"], "path": ["locations"] },
            "description": "Admin thêm địa điểm mới. Nếu không truyền latitude/longitude, server tự động gọi OpenStreetMap Nominatim để lấy tọa độ thực tế."
          }
        },
        {
          "name": "6.4 [Admin] Cập nhật địa điểm",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"F&B Shop - Chi nhánh RMIT Sài Gòn\",\n  \"phone\": \"02899887799\"\n}"
            },
            "url": { "raw": "{{api_url}}/locations/LOCATION_ID_HERE", "host": ["{{api_url}}"], "path": ["locations", "LOCATION_ID_HERE"] },
            "description": "Admin cập nhật thông tin chi nhánh."
          }
        },
        {
          "name": "6.5 [Admin] Xóa địa điểm",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{api_url}}/locations/LOCATION_ID_HERE", "host": ["{{api_url}}"], "path": ["locations", "LOCATION_ID_HERE"] },
            "description": "Admin xóa chi nhánh cửa hàng."
          }
        }
      ]
    },
