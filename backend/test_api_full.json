    {
      "name": "4. Shopping Cart - Giỏ hàng (5 APIs)",
      "item": [
        {
          "name": "4.1 Lấy giỏ hàng cá nhân",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/cart", "host": ["{{api_url}}"], "path": ["cart"] },
            "description": "Lấy tất cả các món trong giỏ hàng của user đang đăng nhập."
          }
        },
        {
          "name": "4.2 Thêm món vào giỏ hàng",
