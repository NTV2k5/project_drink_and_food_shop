    {
      "name": "3. Products - Món ăn & Thực đơn (9 APIs)",
      "item": [
        {
          "name": "3.1 Lấy danh sách món ăn & Lọc",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api_url}}/products?limit=10&page=1&search=trà&featured=true",
              "host": ["{{api_url}}"],
              "path": ["products"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "page", "value": "1" },
                { "key": "search", "value": "trà" },
                { "key": "featured", "value": "true" }
              ]
            },
            "description": "Lấy danh sách sản phẩm có hỗ trợ phân trang, tìm kiếm, lọc danh mục."
