{
  "info": {
    "_postman_id": "9f8e7d6c-5b4a-3f2e-1d0c-9b8a7f6e5d4c",
    "name": "F&B Shop - Full 52 APIs Test Collection",
    "description": "Bộ sưu tập Postman chứa ĐẦY ĐỦ 52 APIs của hệ thống F&B Shop (NodeJS/ExpressJS/MongoDB). Tự động lưu Token (Admin, Customer, Shipper) khi đăng nhập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Users (9 APIs)",
      "item": [
        {
          "name": "1.1 Đăng ký Khách hàng",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn B\",\n  \"email\": \"vanb@gmail.com\",\n  \"phone\": \"0966778899\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/register", "host": ["{{api_url}}"], "path": ["auth", "register"] },
            "description": "Đăng ký tài khoản người dùng mới (Customer)."
          }
        },
        {
          "name": "1.2 Đăng nhập Admin (Lưu admin_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"admin_token\", jsonData.accessToken);",
                  "    pm.environment.set(\"admin_refresh\", jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fb.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/login", "host": ["{{api_url}}"], "path": ["auth", "login"] },
            "description": "Đăng nhập tài khoản Admin và tự động lưu admin_token vào biến môi trường Postman."
          }
        },
        {
          "name": "1.3 Đăng nhập Khách hàng (Lưu customer_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"customer_token\", jsonData.accessToken);",
                  "    pm.environment.set(\"customer_refresh\", jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@fb.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/login", "host": ["{{api_url}}"], "path": ["auth", "login"] },
            "description": "Đăng nhập tài khoản Khách hàng và tự động lưu customer_token vào biến môi trường Postman."
          }
        },
        {
          "name": "1.4 Đăng nhập Shipper (Lưu shipper_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"shipper_token\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"shipper@fb.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/login", "host": ["{{api_url}}"], "path": ["auth", "login"] },
            "description": "Đăng nhập tài khoản Shipper và tự động lưu shipper_token."
          }
        },
        {
          "name": "1.5 Làm mới Access Token (Refresh Token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{customer_refresh}}\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/refresh-token", "host": ["{{api_url}}"], "path": ["auth", "refresh-token"] },
            "description": "Cấp Access Token mới bằng Refresh Token."
          }
        },
        {
          "name": "1.6 Lấy thông tin cá nhân (Profile)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/auth/me", "host": ["{{api_url}}"], "path": ["auth", "me"] },
            "description": "Lấy thông tin tài khoản đang đăng nhập."
          }
        },
        {
          "name": "1.7 Đăng xuất (Logout)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "url": { "raw": "{{api_url}}/auth/logout", "host": ["{{api_url}}"], "path": ["auth", "logout"] },
            "description": "Đăng xuất tài khoản phía client."
          }
        },
        {
          "name": "1.8 [Admin] Lấy danh sách toàn bộ User",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{api_url}}/auth/users", "host": ["{{api_url}}"], "path": ["auth", "users"] },
            "description": "Admin lấy danh sách tất cả các tài khoản trong hệ thống."
          }
        },
        {
          "name": "1.9 [Admin] Cập nhật Vai trò User (Role)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"SHIPPER\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/users/USER_ID_HERE/role", "host": ["{{api_url}}"], "path": ["auth", "users", "USER_ID_HERE", "role"] },
            "description": "Admin phân quyền người dùng sang CUSTOMER / SHIPPER / ADMIN."
          }
        }
      ]
    },
    {
