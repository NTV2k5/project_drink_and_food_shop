            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customer_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"PRODUCT_ID_HERE\",\n  \"quantity\": 2,\n  \"selectedOptions\": [\n    {\n      \"groupId\": \"size-group-id\",\n      \"optionId\": \"size-l-id\"\n    }\n  ],\n  \"note\": \"Ít đá 50%\"\n}"
